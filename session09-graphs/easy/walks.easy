¤ Graph H without the isolated vertex. Neighbors are stored in alphabetical order.
¤ Depth-first from P is P Q T S R. Breadth-first from P is P Q R S T.

procedure Visit(adj, deg, seen, name, order, k, v, step)
array adj(1:5, 1:3)
array deg(1:5)
array seen(1:5)
array name(1:5)
array order(1:5)
seen(v) ← true
k ← k + 1
order(k) ← name(v)
step ← 1
while step <= deg(v) do
  nxt ← adj(v, step)
  if seen(nxt) = false then call Visit(adj, deg, seen, name, order, k, nxt + 0, 0)
  step ← step + 1
endwhile
end Visit

procedure Breadth(adj, deg, seen, name, order, v)
array adj(1:5, 1:3)
array deg(1:5)
array seen(1:5)
array name(1:5)
array order(1:5)
array q(1:5)
qh ← 1
qt ← 1
q(1) ← v
seen(v) ← true
k ← 0
while qh <= qt do
  here ← q(qh)
  qh ← qh + 1
  k ← k + 1
  order(k) ← name(here)
  i ← 1
  while i <= deg(here) do
    u ← adj(here, i)
    if seen(u) = false then [
      seen(u) ← true
      qt ← qt + 1
      q(qt) ← u
    ]
    i ← i + 1
  endwhile
endwhile
end Breadth

procedure Clear(seen)
array seen(1:5)
i ← 1
while i <= 5 do
  seen(i) ← false
  i ← i + 1
endwhile
end Clear

procedure MAIN
array name(1:5)
name(1) ← "P"
name(2) ← "Q"
name(3) ← "R"
name(4) ← "S"
name(5) ← "T"
array deg(1:5)
deg(1) ← 3
deg(2) ← 2
deg(3) ← 1
deg(4) ← 2
deg(5) ← 2
array adj(1:5, 1:3)
adj(1, 1) ← 2
adj(1, 2) ← 3
adj(1, 3) ← 4
adj(2, 1) ← 1
adj(2, 2) ← 5
adj(3, 1) ← 1
adj(4, 1) ← 1
adj(4, 2) ← 5
adj(5, 1) ← 2
adj(5, 2) ← 4
array seen(1:5)
array order(1:5)
call Clear(seen)
k ← 0
call Visit(adj, deg, seen, name, order, k, 1, 0)
output order(1) order(2) order(3) order(4) order(5)
call Clear(seen)
call Breadth(adj, deg, seen, name, order, 1)
output order(1) order(2) order(3) order(4) order(5)
end MAIN
